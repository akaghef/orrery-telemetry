#!/usr/bin/env python3
"""Explicit local capability configuration/show; no agent owner tokens."""
import argparse
import os
from pathlib import Path
import runpy

api=runpy.run_path(str(Path(__file__).resolve().parents[1]/'dashboard/http_operator.py'))
p=argparse.ArgumentParser()
p.add_argument('action',choices=('configure','show'))
a=p.parse_args()
if not os.environ.get('AGENTSTACK_HOME'):
    p.exit(2,'HTTP_OPERATOR_HOME_REQUIRED: set AGENTSTACK_HOME explicitly\n')
home=Path(os.environ['AGENTSTACK_HOME'])
if a.action=='configure':
    print(api['configure'](home))
else:
    print(api['read_capability'](home))
