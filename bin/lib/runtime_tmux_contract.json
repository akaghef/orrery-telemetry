{
  "contract": "orrery-tmux-target-v1",
  "capabilities": [
    "legacy-transport",
    "legacy-target-admission"
  ],
  "operations": [
    "capture",
    "attach",
    "input",
    "split",
    "close",
    "kill-session"
  ],
  "result_properties": {
    "contract": {
      "const": "orrery-tmux-target-v1"
    },
    "ok": {
      "type": "boolean"
    },
    "allowed": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "pattern": "^[A-Z][A-Z_]{2,80}$"
    },
    "transport": {
      "const": "legacy-default"
    },
    "socket_path": {
      "type": "string",
      "pattern": "^/"
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "environment_unset": {
      "const": [
        "TMUX",
        "TMUX_PANE"
      ]
    },
    "server_pid": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "operation": {
      "enum": [
        "capture",
        "attach",
        "input",
        "split",
        "close",
        "kill-session"
      ]
    },
    "panes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session_id",
          "session",
          "pane_id",
          "pid",
          "process_start"
        ],
        "properties": {
          "session_id": {
            "type": "string",
            "pattern": "^\\$[0-9]+$"
          },
          "session": {
            "type": "string"
          },
          "pane_id": {
            "type": "string",
            "pattern": "^%[0-9]+$"
          },
          "pid": {
            "type": "integer",
            "minimum": 1
          },
          "process_start": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "capabilities": {
      "const": [
        "legacy-transport",
        "legacy-target-admission"
      ]
    }
  },
  "result_fields": {
    "capabilities": [
      "contract",
      "capabilities"
    ],
    "legacy-transport": [
      "contract",
      "ok",
      "transport",
      "socket_path",
      "argv",
      "environment_unset",
      "server_pid"
    ],
    "legacy-target": [
      "contract",
      "ok",
      "transport",
      "socket_path",
      "argv",
      "environment_unset",
      "server_pid",
      "allowed",
      "operation",
      "panes",
      "state_sha256"
    ],
    "error": [
      "contract",
      "ok",
      "allowed",
      "reason"
    ]
  }
}
